---
import globalStyles from '../styles/global.css?url';
import manrope400 from '@fontsource/manrope/files/manrope-latin-400-normal.woff2?url';
import marcellus400 from '@fontsource/marcellus/files/marcellus-latin-400-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import WhatsAppIntentTracker from '../components/WhatsAppIntentTracker.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import CurrencyEngine from '../components/CurrencyEngine.astro';
import { SITE } from '../data/site';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  schemas?: object[];
  preloadImage?: string;
  preloadImageSrcset?: string;
  preloadImageSizes?: string;
}

const {
  title,
  description = SITE.description,
  canonical = Astro.url.href,
  ogImage = `${SITE.url}/og-default.png?v=2`,
  type = 'website',
  noindex = false,
  schemas = [],
  preloadImage,
  preloadImageSrcset,
  preloadImageSizes,
} = Astro.props;

const TITLE_BUDGET = 60;
const SUFFIX = ' | Greek Invest';
const fullTitle = title.includes('Greek Invest')
  ? title
  : title.length + SUFFIX.length <= TITLE_BUDGET
    ? `${title}${SUFFIX}`
    : title;

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.name,
  url: SITE.url,
  description: SITE.description,
  email: SITE.email,
  logo: { '@type': 'ImageObject', url: `${SITE.url}/favicon.svg` },
  contactPoint: {
    '@type': 'ContactPoint',
    email: SITE.email,
    contactType: 'customer service',
    availableLanguage: ['English'],
  },
  sameAs: [
    SITE.url,
    ...SITE.sameAs,
    ...(SITE.wikidataId ? [`https://www.wikidata.org/wiki/${SITE.wikidataId}`] : []),
  ],
};

const allSchemas = [orgSchema, ...schemas];
---
<!doctype html>
<html lang="en" dir="ltr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#0e2a33" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  {noindex
    ? <meta name="robots" content="noindex,nofollow" />
    : <meta name="robots" content="index,follow,max-image-preview:large" />}
  {!noindex && <link rel="canonical" href={canonical} />}
  <meta property="og:type" content={type} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:type" content="image/png" />
  <meta property="og:image:alt" content={fullTitle} />
  <meta name="twitter:image" content={ogImage} />
  <meta property="og:site_name" content={SITE.name} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <link rel="icon" href="/favicon.svg?v=3" type="image/svg+xml" />
  <link rel="icon" href="/favicon-32.png?v=3" type="image/png" sizes="32x32" />
  <link rel="icon" href="/favicon-16.png?v=3" type="image/png" sizes="16x16" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=3" sizes="180x180" />
  <link rel="manifest" href="/site.webmanifest" />

  <link rel="preload" href={manrope400} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={marcellus400} as="font" type="font/woff2" crossorigin />

  <link rel="preconnect" href="https://res.cloudinary.com" crossorigin />
  <link rel="dns-prefetch" href="https://res.cloudinary.com" />

  {preloadImage && (
    <link
      rel="preload"
      as="image"
      href={preloadImage}
      fetchpriority="high"
      {...(preloadImageSrcset ? { imagesrcset: preloadImageSrcset, imagesizes: preloadImageSizes } : {})}
    />
  )}

  <style is:inline>
    :root {
      --color-frame: #0e2a33;
      --color-frame-line: rgba(232, 226, 212, 0.18);
      --color-frame-text: #f0f4f2;
      --color-frame-muted: #9fb7bb;
      --color-marble: #e8e2d4;
      --color-marble-deep: #c8bda6;
      --color-page: #f8f5ee;
      --color-ink: #15242b;
      --color-muted: #59696f;
      --color-teal: #1d6f86;
      --font-sans: 'Manrope', system-ui, sans-serif;
      --font-serif: 'Marcellus', Georgia, serif;
    }
    html { -webkit-font-smoothing: antialiased; }
    body {
      margin: 0;
      background: var(--color-page);
      color: var(--color-muted);
      font-family: var(--font-sans);
      line-height: 1.65;
      font-size: 1rem;
      min-height: 100dvh;
      display: flex;
      flex-direction: column;
    }
    body > main { flex: 1 0 auto; }
    .site-header {
      position: sticky;
      top: 0;
      z-index: 50;
      background: var(--color-frame);
      border-bottom: 1px solid var(--color-frame-line);
    }
    .gr-wordmark { font-family: var(--font-serif); color: var(--color-frame-text); }
    .gr-hero {
      background: var(--color-frame);
      color: var(--color-frame-text);
    }
    .gr-hero__title {
      font-family: var(--font-serif);
      color: var(--color-frame-text);
      line-height: 1.12;
    }
    .gr-hero__figure img {
      display: block;
      width: 100%;
      object-fit: cover;
    }
    .gr-hero__cta {
      display: inline-block;
      background: var(--color-marble);
      color: var(--color-frame);
      font-weight: 600;
      text-decoration: none;
      border-radius: 999px;
    }
  </style>
  <link rel="stylesheet" href={globalStyles} />

  {allSchemas.map((s) => (
    <script type="application/ld+json" set:html={JSON.stringify(s)} />
  ))}
</head>
<body>
  <Header />
  <main>
    <slot />
  </main>
  <Footer />
  <WhatsAppFloat />
  <CurrencyEngine />
  <WhatsAppIntentTracker />
  <GoogleAnalytics />
</body>
</html>
