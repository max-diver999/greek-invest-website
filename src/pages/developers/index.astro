---
export const prerender = true;
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../data/site';
import ContentCard from '../../components/ContentCard.astro';

const developers = (await getCollection('developers'))
  .filter((d) => !d.data.noindex)
  .sort((a, b) => a.data.title.localeCompare(b.data.title));
const hubUrl = `${SITE.url}/developers/`;
const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Developer profiles',
    url: hubUrl,
    isPartOf: { '@type': 'WebSite', name: SITE.name, url: SITE.url },
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: developers.length,
      itemListElement: developers.map((e, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        url: `${SITE.url}/developers/${e.id}/`,
        name: e.data.title,
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: 'Developers', item: hubUrl },
    ],
  },
];
---
<BaseLayout
  canonical={hubUrl}
  {schemas}
  title="Greece Real Estate Developers"
  description="Developer profiles for Athens, Crete, and Cyclades projects: track record, project links, and due diligence notes for foreign buyers."
>
  <section class="site-container py-14 md:py-20">
    <nav class="text-sm text-[var(--color-muted)] mb-6" aria-label="Breadcrumb">
      <a href="/" class="no-underline hover:underline">Home</a> <span aria-hidden="true">›</span> <span>Developers</span>
    </nav>
    <header class="max-w-2xl mb-12">
      <h1 class="text-3xl">Developer profiles</h1>
      <p class="text-lg text-[var(--color-muted)] mt-3">
        Entity authority reviews, not sales brochures. Verify permits, delivery history, and escrow before any deposit.
      </p>
    </header>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {developers.map((dev) => (
        <ContentCard
          href={`/developers/${dev.id}/`}
          title={dev.data.title}
          description={dev.data.description}
          image={dev.data.heroImage}
          badges={['Developer']}
          meta={`${dev.data.readingTime ?? 8} min read`}
          placeholder="🏗️"
        />
      ))}
    </div>
  </section>
</BaseLayout>
