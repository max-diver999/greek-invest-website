---
import { SITE } from '../data/site';
import CurrencyToggle from './CurrencyToggle.astro';

/**
 * Navigation leads with Golden Visa: it is the site's commercial core and
 * previously had no nav entry at all. Tools were unreachable too — no page
 * linked the rental-yield calculator.
 */
const nav = [
  { label: 'Golden Visa', href: '/golden-visa/' },
  // Added September 2026 with the two hubs themselves. They shipped as routes
  // with no nav entry, which is the same defect this comment already describes
  // for Golden Visa and Tools: /property-for-sale/ carries the largest measured
  // demand cluster on the site and had no sitewide path in.
  { label: 'Property for Sale', href: '/property-for-sale/' },
  { label: 'Living in Greece', href: '/living-in-greece/' },
  { label: 'Guides', href: '/guides/' },
  { label: 'Areas', href: '/areas/' },
  { label: 'Projects', href: '/projects/' },
  { label: 'Compare', href: '/compare/' },
  { label: 'Tools', href: '/tools/' },
  { label: 'About', href: '/about/' },
];

const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<header class="site-header">
  <div class="site-container site-header__bar">
    <a href="/" class="site-header__brand" aria-label={`${SITE.name} home`}>
      <span class="gr-wordmark"><span class="gr-wordmark__accent">Greek</span> Invest</span>
    </a>

    <nav class="site-header__nav" aria-label="Primary">
      {nav.map((item) => (
        <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>

    <CurrencyToggle variant="header" />
    <a href="/get-shortlist/" class="btn-primary site-header__cta">Free shortlist</a>

    <!--
      Mobile navigation. Previously the nav was `hidden md:flex` with no
      alternative, so below the md breakpoint the entire site was unreachable
      except the logo and the CTA. <details> keeps this working without JS.
    -->
    <details class="site-header__menu">
      <summary aria-label="Open navigation">
        <span class="site-header__burger" aria-hidden="true"><i></i><i></i><i></i></span>
      </summary>
      <nav class="site-header__drawer" aria-label="Mobile">
        <a href="/get-shortlist/" class="site-header__drawer-cta">Get a free shortlist</a>
        <CurrencyToggle variant="drawer" />
        {nav.map((item) => (
          <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
        ))}
        <a href="/developers/">Developers</a>
        <a href="/news/">News</a>
        <a href="/contact/">Contact</a>
      </nav>
    </details>
  </div>
</header>

<style>
  /* Тёмная рама: шапка держит тот же чернильный тон, что герой и подвал —
     светлая витрина начинается сразу под ней. */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--color-frame-line);
    background: var(--color-frame);
  }
  .site-header__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1rem;
  }
  .site-header__brand {
    display: flex;
    align-items: center;
    text-decoration: none;
    flex-shrink: 0;
  }
  .gr-wordmark {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-frame-text);
    white-space: nowrap;
  }
  .gr-wordmark__accent { color: var(--color-marble-deep); }
  .site-header__nav {
    display: none;
    align-items: center;
    gap: 1.4rem;
    margin-left: 2.5rem;
    margin-right: auto;
    font-size: 0.875rem;
    font-weight: 500;
  }
  .site-header__nav a {
    color: var(--color-frame-muted);
    text-decoration: none;
    white-space: nowrap;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.72rem;
    font-weight: 500;
    transition: color 0.2s ease;
  }
  .site-header__nav a:hover { color: var(--color-marble); }
  .site-header__drawer a:hover { color: var(--color-ink); }
  .site-header__nav a[aria-current='page'] {
    color: var(--color-marble);
    font-weight: 600;
  }
  .site-header__cta {
    display: none;
    font-size: 0.72rem;
    padding: 0.55rem 1.15rem;
    flex-shrink: 0;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    background: transparent;
    color: var(--color-marble) !important;
    border: 1px solid var(--color-marble-deep);
    border-radius: 2px;
    box-shadow: none;
  }
  .site-header__cta:hover {
    background: var(--color-marble);
    color: var(--color-frame) !important;
  }

  /* --- mobile disclosure --- */
  .site-header__menu { position: static; }
  .site-header__menu > summary {
    list-style: none;
    cursor: pointer;
    padding: 0.5rem;
    margin: -0.5rem;
    border-radius: 0.5rem;
    /* 44px tap target */
    min-width: 44px;
    min-height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .site-header__menu > summary::-webkit-details-marker { display: none; }
  .site-header__menu > summary:focus-visible { outline: 2px solid var(--color-teal); outline-offset: 2px; }
  .site-header__burger { display: grid; gap: 5px; width: 22px; }
  .site-header__burger i { display: block; height: 2px; background: var(--color-marble); border-radius: 2px; }
  .site-header__menu[open] > summary .site-header__burger i:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .site-header__menu[open] > summary .site-header__burger i:nth-child(2) { opacity: 0; }
  .site-header__menu[open] > summary .site-header__burger i:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
  .site-header__burger i { transition: transform 0.18s ease, opacity 0.18s ease; }

  .site-header__drawer {
    position: fixed;
    inset: 73px 0 0;
    z-index: 60;
    display: grid;
    gap: 0.25rem;
    align-content: start;
    padding: 1.25rem clamp(1.25rem, 5vw, 2rem) 2rem;
    background: var(--color-surface);
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .site-header__drawer a {
    padding: 0.6rem 0.7rem;
    border-radius: 0.5rem;
    text-decoration: none;
    color: var(--color-muted);
    font-size: 0.95rem;
  }
  .site-header__drawer a[aria-current='page'] { color: var(--color-ink); font-weight: 600; }
  .site-header__drawer-cta {
    margin-top: 0.35rem;
    background: var(--color-teal);
    color: #fff !important;
    font-weight: 600;
    text-align: center;
  }

  @media (min-width: 900px) {
    .site-header__nav { display: flex; }
    .site-header__cta { display: inline-flex; }
    .site-header__menu { display: none; }
  }
</style>

<script>
  // Close the drawer on outside click and on Escape.
  const menu = document.querySelector('.site-header__menu');
  if (menu instanceof HTMLDetailsElement) {
    menu.addEventListener('toggle', () => {
      document.body.style.overflow = menu.open ? 'hidden' : '';
    });
    menu.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => {
      menu.open = false;
    }));
    document.addEventListener('click', (e) => {
      if (menu.open && !menu.contains(e.target as Node)) menu.open = false;
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.open) menu.open = false;
    });
    window.addEventListener('resize', () => {
      if (window.innerWidth >= 900) menu.open = false;
    });
  }
</script>
