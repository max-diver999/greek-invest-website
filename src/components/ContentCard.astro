---
import { getCardImageUrl } from '../lib/cardImage';

interface Props {
  href: string;
  title: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  badges?: string[];
  meta?: string;
  metaAccent?: boolean;
}

const {
  href,
  title,
  description = '',
  image,
  imageAlt,
  badges = [],
  meta,
  metaAccent = false,
} = Astro.props;

const photo = getCardImageUrl(image);
---

<a href={href} class="gr-card is-link block no-underline h-full">
  {photo ? (
    <div class="gr-card__media">
      <img
        src={photo}
        alt={imageAlt || title}
        loading="lazy"
        decoding="async"
        width="640"
        height="427"
      />
    </div>
  ) : (
    <div class="gr-card__media gr-card__media--placeholder" aria-hidden="true"></div>
  )}
  <div class="gr-card__body">
    {badges.length > 0 && <p class="gr-card__meta">{badges.slice(0, 2).join(' · ')}</p>}
    <h3 class="gr-card__title">{title}</h3>
    {description && <p class="gr-card__excerpt">{description}</p>}
    {meta && <p class="gr-card__meta gr-card__rule pt-3">{meta}</p>}
  </div>
</a>
