---
import { SITE } from '../data/site';
const year = new Date().getFullYear();

/**
 * The footer previously exposed three links (Guides, Comparisons, Methodology),
 * leaving Areas, Projects, Developers, Tools, News and both consultation pages
 * with no sitewide path in.
 */
const columns = [
  {
    heading: 'Research',
    links: [
      { label: 'Golden Visa hub', href: '/golden-visa/' },
      { label: 'Investment guides', href: '/guides/' },
      { label: 'Area guides', href: '/areas/' },
      { label: 'Market comparisons', href: '/compare/' },
      { label: 'News', href: '/news/' },
    ],
  },
  {
    heading: 'Projects & tools',
    links: [
      { label: 'Project reviews', href: '/projects/' },
      { label: 'Developers', href: '/developers/' },
      { label: 'Rental yield calculator', href: '/tools/greece-rental-yield-calculator/' },
      { label: 'Purchase cost calculator', href: '/tools/greece-property-cost-calculator/' },
      { label: 'Golden Visa zone lookup', href: '/tools/greece-golden-visa-zone-lookup/' },
    ],
  },
  {
    heading: 'Talk to us',
    links: [
      { label: 'Golden Visa consultation', href: '/greece-golden-visa-consultation/' },
      { label: 'Property consultation', href: '/greece-property-consultation/' },
      { label: 'Free shortlist', href: '/get-shortlist/' },
      { label: 'Contact', href: '/contact/' },
    ],
  },
  {
    heading: 'About',
    links: [
      { label: 'About Greek Invest', href: '/about/' },
      { label: 'Methodology', href: '/methodology/' },
      { label: 'Privacy', href: '/privacy-policy/' },
      { label: 'Terms', href: '/terms/' },
    ],
  },
];
---
<footer class="mt-16 border-t border-[var(--color-border)] bg-[var(--color-ink)] text-[#d6d3d1]">
  <div class="site-container py-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-5 text-sm">
    <div class="lg:col-span-1">
      <p class="text-lg font-semibold text-white mb-2">{SITE.name}</p>
      <p class="leading-relaxed">{SITE.tagline}</p>
      <p class="mt-4">
        <a href={`mailto:${SITE.email}`} class="text-[#d6d3d1] hover:text-white no-underline">{SITE.email}</a>
      </p>
    </div>

    {columns.map((col) => (
      <div>
        <p class="font-semibold text-white mb-3">{col.heading}</p>
        <ul class="space-y-2">
          {col.links.map((l) => (
            <li><a href={l.href} class="text-[#d6d3d1] hover:text-white no-underline">{l.label}</a></li>
          ))}
        </ul>
      </div>
    ))}
  </div>

  <div class="site-container py-4 border-t border-white/10 text-xs text-[#a8a29e]">
    © {year} {SITE.name}. Independent research, not financial or legal advice. Verify all figures with licensed professionals.
  </div>
</footer>
