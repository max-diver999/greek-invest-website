---
export const prerender = true;
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../data/site';

const articles = (await getCollection('news'))
  .filter((n) => !n.data.noindex)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const hubUrl = `${SITE.url}/news/`;
const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Market news',
    url: hubUrl,
    isPartOf: { '@type': 'WebSite', name: SITE.name, url: SITE.url },
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: articles.length,
      itemListElement: articles.map((e, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        url: `${SITE.url}/news/${e.id}/`,
        name: e.data.title,
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: 'News', item: hubUrl },
    ],
  },
];
---
<BaseLayout
  canonical={hubUrl}
  {schemas}
  title="Greece Real Estate News"
  description="Market updates for foreign buyers: Golden Visa rule changes, Athens and Crete prices, ENFIA, and rental regulation."
>
  <div class="gr-band">
    <div class="site-container py-11 md:py-14">
      <nav class="text-sm text-[var(--color-frame-muted)] mb-6" aria-label="Breadcrumb">
      <a href="/" class="no-underline hover:underline">Home</a> <span aria-hidden="true">›</span> <span>News</span>
    </nav>
      <header class="max-w-2xl mb-12">
      <h1>Market news</h1>
      <p class="text-lg text-[var(--color-frame-muted)] mt-3">
        Data-driven updates on Greece property markets; verify figures with counsel before investment decisions.
      </p>
    </header>
    </div>
  </div>

  <section class="site-container py-14 md:py-20">
    <div class="grid gap-8 max-w-3xl">
      {articles.map((article) => (
        <a href={`/news/${article.id}/`} class="gr-card is-link block no-underline">
          <div class="gr-card__body pt-0">
            <p class="gr-card__meta">
              <time datetime={article.data.pubDate.toISOString()}>
                {article.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
              </time>
            </p>
            <h2 class="gr-card__title">{article.data.title}</h2>
            <p class="gr-card__excerpt">{article.data.description}</p>
          </div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
