---
import BaseLayout from './BaseLayout.astro';
import LeadForm from '../components/LeadForm.astro';
import FaqBlock from '../components/FaqBlock.astro';
import RelatedArticles from '../components/RelatedArticles.astro';
import type { RelatedItem } from '../lib/related';
import { SITE } from '../data/site';
import { responsiveCloudinary } from '../lib/cloudinary';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  author?: string;
  readingTime?: number;
  heroImage?: string;
  heroAlt?: string;
  faq?: { question: string; answer: string }[];
  canonical?: string;
  noindex?: boolean;
  hasInlineFaqBlock?: boolean;
  contextLabel?: string;
  related?: RelatedItem[];
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  author = SITE.editorial,
  readingTime = 8,
  heroImage,
  heroAlt,
  faq = [],
  canonical,
  noindex = false,
  hasInlineFaqBlock = false,
  contextLabel = title,
  related = [],
} = Astro.props;

const dateStr = (updatedDate || pubDate).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const pageUrl = canonical || Astro.url.href;
const responsiveHero = heroImage ? responsiveCloudinary(heroImage) : null;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate || pubDate).toISOString(),
  author: {
    '@type': 'Person',
    name: author,
    jobTitle: SITE.authorRole,
    url: `${SITE.url}/about/`,
    worksFor: { '@type': 'Organization', name: SITE.name, url: SITE.url },
  },
  publisher: {
    '@type': 'Organization',
    name: SITE.name,
    url: SITE.url,
    logo: { '@type': 'ImageObject', url: `${SITE.url}/favicon-192.png`, width: 192, height: 192 },
  },
  isAccessibleForFree: true,
  inLanguage: 'en',
  mainEntityOfPage: pageUrl,
  ...(heroImage ? { image: heroImage } : {}),
};

const faqSchema = faq.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
} : null;

const pathParts = Astro.url.pathname.split('/').filter(Boolean);
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
    ...(pathParts.length > 1 ? [{
      '@type': 'ListItem',
      position: 2,
      name: pathParts[0].charAt(0).toUpperCase() + pathParts[0].slice(1),
      item: `${SITE.url}/${pathParts[0]}/`,
    }] : []),
    {
      '@type': 'ListItem',
      position: pathParts.length > 1 ? 3 : 2,
      name: title,
      item: pageUrl,
    },
  ],
};

// Single FAQPage owner. The inline <FaqBlock> in MDX emits its own FAQPage, so the
// layout must not emit a second one — 132 pages previously shipped duplicates and
// 7 shipped conflicting question sets.
const schemas = [articleSchema, breadcrumbSchema, ...(faqSchema && !hasInlineFaqBlock ? [faqSchema] : [])];
---
<BaseLayout
  title={title}
  description={description}
  canonical={pageUrl}
  ogImage={heroImage}
  type="article"
  {noindex}
  {schemas}
>
  <div class="gr-band">
    <div class="site-container py-10 md:py-14">
      <header class="max-w-3xl">
        <span class="gr-band__badge mb-5 inline-block">Research guide</span>
        <h1 class="mb-4">{title}</h1>
        <p class="text-lg text-[var(--color-frame-muted)] mb-4">{description}</p>
        <p class="text-sm text-[var(--color-frame-muted)]">
          By <a href="/about/" class="underline decoration-dotted underline-offset-2">{author}</a>, {SITE.authorRole} · Updated {dateStr} · {readingTime} min read
        </p>
      </header>
    </div>
  </div>

  <article class="site-container py-10 md:py-14">

    {heroImage && (
      <img
        src={responsiveHero?.src || heroImage}
        srcset={responsiveHero?.srcset}
        sizes={responsiveHero?.sizes}
        alt={heroAlt || `${title} — Greek Invest research illustration`}
        class="w-full max-h-[440px] object-cover rounded-[16px] mb-10"
        width={responsiveHero?.width || 1200}
        height={responsiveHero?.height || 675}
        loading="eager"
        fetchpriority="high"
      />
    )}

    <div class="prose mx-auto">
      <slot />
    </div>

    {!hasInlineFaqBlock && faq.length > 0 && (
      <div class="max-w-3xl mx-auto mt-10">
        <FaqBlock items={faq} />
      </div>
    )}

    <RelatedArticles items={related} />

    <div class="max-w-3xl mx-auto mt-12">
      <LeadForm
        title="Get your Greece property shortlist"
        subtitle="Share your budget, region (Athens, Crete, islands, or Peloponnese), and Golden Visa goal. We reply within one business day with matched options and next steps."
        context={contextLabel}
      />
    </div>

    <!--
      Disclaimer only. An earlier version of this block also repeated the byline
      and restated the four publication checks on all 139 pages: the byline is
      already above, and the checks belong once, on /methodology/.
    -->
    <aside class="max-w-3xl mx-auto mt-12 surface-card p-5 text-sm text-[var(--color-muted)]">
      <strong>Disclaimer:</strong> Greek Invest is an independent editorial resource, not a developer,
      law firm or licensed Greek broker, and is not paid by developers for placement. Golden Visa
      thresholds, taxes and transfer rules change: verify with your lawyer and AADE before any
      transaction. <a href="/methodology/">How we research</a>.
    </aside>
  </article>
</BaseLayout>
