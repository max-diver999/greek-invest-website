{
  "name": "greek-invest-website",
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "postbuild": "node scripts/audit-rendered-live.mjs --local --fail",
    "preview": "astro preview",
    "healthcheck": "node scripts/post-deploy-smoke.mjs --http-only",
    "validate:content": "node scripts/qa-audit.mjs",
    "check:jurisdiction": "node scripts/check-jurisdiction.mjs",
    "geo:audit": "node scripts/geo-citability-audit.mjs",
    "aeo:verify": "node scripts/reference-infra/verify-reference-infra.mjs --config reference-infra.config.json --robots public/robots.txt",
    "aeo:dates": "node scripts/reference-infra/restore-real-updated-dates.mjs --config reference-infra.config.json",
    "aeo:markdown": "node scripts/reference-infra/fix-markdown-structure.mjs --config reference-infra.config.json",
    "aeo:robots": "node scripts/reference-infra/generate-robots.mjs --config reference-infra.config.json",
    "aeo:llms": "node scripts/reference-infra/generate-agent-markdown.mjs --config reference-infra.config.json",
    "validate:content:changed": "node scripts/qa-audit.mjs --changed",
    "qa:corpus": "node scripts/qa-corpus-signals.mjs",
    "qa:full": "node scripts/qa-full.mjs",
    "qa:full:quick": "node scripts/qa-full.mjs --quick",
    "corpus:cleanup": "node scripts/corpus-cleanup.mjs",
    "corpus:excellence": "node scripts/spain-corpus-excellence.mjs",
    "prepush:gate": "node scripts/pre-push-gate.mjs",
    "setup:hooks": "git config core.hooksPath .githooks && chmod +x .githooks/pre-push && echo 'Git hooks → .githooks (pre-push runs validate:content + build on MDX changes)'",
    "fix:queue": "node scripts/fix-batch-queue.mjs",
    "fix:card": "node scripts/fix-content-card.mjs",
    "refresh:protected": "node scripts/refresh-protected-slugs.mjs",
    "audit:rendered": "node scripts/audit-rendered-live.mjs",
    "audit:rendered:fail": "node scripts/audit-rendered-live.mjs --fail",
    "fix:leadforms": "node scripts/fix-inline-leadforms.mjs",
    "sync:content-gate": "node scripts/sync-content-gate.mjs",
    "validate:strict": "node scripts/qa-audit.mjs",
    "audit:images": "node scripts/audit-all-images.mjs --fail",
    "gen:llms": "node scripts/generate-llms-txt.mjs",
    "prebuild": "node scripts/generate-llms-txt.mjs",
    "speed:dims": "node scripts/build-cloudinary-dims.mjs",
    "speed:verify": "node scripts/verify-responsive-images.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "5.0.2",
    "@astrojs/sitemap": "3.7.1",
    "@astrojs/vercel": "10.0.2",
    "@tailwindcss/vite": "4.2.2",
    "astro": "6.0.8",
    "google-auth-library": "^10.6.2",
    "tailwindcss": "4.2.2",
    "unist-util-visit": "^5.1.0"
  }
}
