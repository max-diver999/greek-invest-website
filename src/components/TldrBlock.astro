---
interface Props {
  text?: string;
}

// One page passes the TLDR as children rather than via text; the slot below
// carries that case, and text may therefore be absent.
const { text = '' } = Astro.props;

// TLDR texts are authored as plain string props, so an inline markdown link
// ([label](/path/)) would otherwise reach the page as literal brackets.
// Only site-internal links are converted; anything else stays literal text.
type Part = { text: string } | { label: string; href: string };
const parts: Part[] = [];
const linkRe = /\[([^\]]+)\]\((\/[^)\s]+)\)/g;
let last = 0;
let m: RegExpExecArray | null;
while ((m = linkRe.exec(text)) !== null) {
  if (m.index > last) parts.push({ text: text.slice(last, m.index) });
  parts.push({ label: m[1], href: m[2] });
  last = m.index + m[0].length;
}
if (last < text.length) parts.push({ text: text.slice(last) });
---
<aside class="tldr-block" itemprop="abstract">
  <div class="tldr-label">Key Takeaway</div>
  {text ? <p>{parts.map((p) => ('href' in p ? <a href={p.href}>{p.label}</a> : p.text))}</p> : <slot />}
</aside>

<style>
  .tldr-block {
    border-left: 4px solid var(--color-teal, #2c6b62);
    background: linear-gradient(135deg, var(--color-teal-light, #e6f0ed) 0%, #fafaf8 100%);
    border-radius: 0 12px 12px 0;
    padding: 16px 20px;
    margin: 0 0 24px 0;
    font-size: 15px;
    line-height: 1.65;
    color: var(--color-ink, #1f2421);
  }
  .tldr-label {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-teal-dark, #235851);
    margin-bottom: 6px;
  }
  .tldr-block p {
    margin: 0;
  }
</style>
