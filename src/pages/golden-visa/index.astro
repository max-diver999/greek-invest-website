---
export const prerender = true;
import { getCollection, render } from 'astro:content';
import { readingMinutes } from '../../lib/readingTime';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentCard from '../../components/ContentCard.astro';
import LeadForm from '../../components/LeadForm.astro';
import { SITE } from '../../data/site';

/**
 * Canonical entry point for the Golden Visa cluster.
 *
 * The site's whole commercial thesis is the Greek Golden Visa, yet there was no hub:
 * no nav entry, no single page collecting the 38 Golden Visa guides, and the
 * consultation page received 113 internal links while ranking around position 78.
 */
// The hub's body. It lives in src/content/golden-visa/overview.mdx rather than
// inline here, because prose written into an .astro file is invisible to qa-audit,
// geo-score and the cannibalisation checker. Before this, the page ran straight
// from the tier table to the card grid with no body at all.
const overview = (await getCollection('golden-visa')).find((e) => e.id === 'overview');
if (!overview) {
  throw new Error('src/content/golden-visa/overview.mdx is missing: the hub has no body.');
}
const { Content } = await render(overview);

const guides = await getCollection('guides');
const byId = Object.fromEntries(guides.map((g) => [g.id, g]));

const sections = [
  {
    id: 'rules',
    heading: 'The rules that decide whether a property qualifies',
    intro:
      'Get these four wrong and the file fails at the Ministry, usually after the deposit has left your account.',
    slugs: [
      'greece-golden-visa-property-tiers-2026',
      'greece-golden-visa-120-square-meter-rule',
      'greece-golden-visa-circular-2026-explained',
      'greece-golden-visa-no-short-term-rental',
    ],
  },
  {
    id: 'tiers',
    heading: 'Where your budget actually buys',
    intro:
      '€800,000 in Attica, Thessaloniki, Mykonos, Santorini and the larger islands. €400,000 everywhere else. €250,000 only for heritage restoration and conversion.',
    slugs: [
      'crete-property-investment-guide',
      'peloponnese-property-investment-guide',
      'rhodes-property-investment',
      'athens-golden-visa-800000-areas',
      'thessaloniki-golden-visa-800000-property',
      'greece-golden-visa-250000-conversion-route',
    ],
  },
  {
    id: 'process',
    heading: 'From reservation to residence permit',
    intro: 'Realistic timelines, the documents that hold files up, and the money-movement rules under Circular 1/2026.',
    slugs: [
      'greece-golden-visa-timeline-application-2026',
      'golden-visa-greece-bank-transfer-proof-funds',
      'greece-golden-visa-bank-account-afm',
      'golden-visa-property-due-diligence-checklist',
      'golden-visa-lawyer-greece-complete-guide',
      'greece-golden-visa-lawyer-cost',
    ],
  },
  {
    id: 'family',
    heading: 'Family, renewal and the long game',
    intro: 'Who you can include, what renewal actually requires, and where the citizenship clock really starts.',
    slugs: [
      'greece-golden-visa-family-members-rules',
      'golden-visa-parents-dependents-included',
      'greece-golden-visa-renewal-requirements',
      'how-long-can-you-stay-greece-golden-visa',
      'greece-citizenship-after-golden-visa',
      'can-you-sell-property-after-golden-visa-greece',
    ],
  },
  {
    id: 'nationality',
    heading: 'By where you are applying from',
    intro: 'Treaty treatment, home-country reporting and transfer mechanics differ more than the visa rules do.',
    slugs: [
      'greece-golden-visa-us-citizens',
      'greece-golden-visa-canadian-buyers',
      'greece-golden-visa-uae-buyers',
      'greece-golden-visa-indian-buyers',
      'brexit-uk-buyers-greece-property',
      'israeli-buyers-greece-property',
    ],
  },
];

const resolved = sections.map((s) => ({
  ...s,
  items: s.slugs.map((slug) => byId[slug]).filter(Boolean),
}));

const tiers = [
  { tier: '€800,000', where: 'Attica, Thessaloniki, Mykonos, Santorini, islands over 3,100 residents', note: 'One property, 120 m² minimum' },
  { tier: '€400,000', where: 'The rest of Greece, including most of Crete and the Peloponnese', note: 'One property, 120 m² minimum' },
  { tier: '€250,000', where: 'Heritage restoration, or commercial-to-residential conversion', note: 'Exempt from the 120 m² rule' },
];

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Greece Golden Visa research hub',
    description: 'Independent research on the Greece Golden Visa property route: 2026 tiers, the 120 m² rule, timelines, costs and renewal.',
    url: `${SITE.url}/golden-visa/`,
    hasPart: resolved.flatMap((s) =>
      s.items.map((g) => ({ '@type': 'Article', name: g.data.title, url: `${SITE.url}/guides/${g.id}/` })),
    ),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: 'Golden Visa', item: `${SITE.url}/golden-visa/` },
    ],
  },
];
---
<BaseLayout
  title="Greece Golden Visa 2026: Tiers, Rules and Timeline"
  description="Independent Greece Golden Visa research: €250K/€400K/€800K tiers, the 120 m² usable-area rule, Circular 1/2026, realistic timelines, costs and renewal."
  canonical={`${SITE.url}/golden-visa/`}
  {schemas}
>
  <div class="gr-band">
    <div class="site-container py-11 md:py-14">
      <nav class="text-sm text-[var(--color-frame-muted)] mb-6" aria-label="Breadcrumb">
      <a href="/" class="no-underline hover:underline">Home</a> <span aria-hidden="true">›</span> <span>Golden Visa</span>
    </nav>
      <header class="max-w-3xl mb-10">
      <span class="gr-band__badge mb-4">Independent research</span>
      <h1 class="mb-4">Greece Golden Visa, without the brochure</h1>
    </header>
    </div>
  </div>

  <section class="site-container py-12 md:py-16">

    <div class="surface-card overflow-x-auto mb-4">
      <table class="w-full text-sm">
        <caption class="sr-only">Greece Golden Visa property tiers under Law 5100/2024</caption>
        <thead>
          <tr>
            <th scope="col" class="text-left p-3">Tier</th>
            <th scope="col" class="text-left p-3">Where it applies</th>
            <th scope="col" class="text-left p-3">Area rule</th>
          </tr>
        </thead>
        <tbody>
          {tiers.map((t) => (
            <tr>
              <td class="p-3 font-semibold text-[var(--color-ink)] whitespace-nowrap">{t.tier}</td>
              <td class="p-3">{t.where}</td>
              <td class="p-3">{t.note}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="text-xs text-[var(--color-muted)] mb-12">
      Source: Law 5100/2024 as operationalised by Circular 1/2026 of the Ministry of Migration and Asylum,
      published 22 April 2026. Verify the tier against the cadastral parcel, not the postal address.
    </p>

    <div class="prose-body max-w-3xl mb-16">
      <Content />
    </div>

    <div class="flex flex-wrap gap-3 mb-16">
      <a href="/greece-golden-visa-consultation/" class="btn-primary px-6 py-3">Book a Golden Visa consultation</a>
      <a href="/tools/greece-golden-visa-zone-lookup/" class="btn-secondary px-6 py-3">Check a zone</a>
      <a href="/guides/golden-visa-eligible-projects-directory/" class="btn-secondary px-6 py-3">Eligible projects →</a>
    </div>

    {resolved.map((s) => (
      <section class="mb-16" id={s.id}>
        <h2 class="text-2xl mb-2">{s.heading}</h2>
        <p class="text-[var(--color-muted)] mb-6 max-w-2xl">{s.intro}</p>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-x-7 gap-y-10">
          {s.items.map((g) => (
            <ContentCard
              href={`/guides/${g.id}/`}
              title={g.data.title}
              description={g.data.description}
              image={g.data.heroImage}
              imageAlt={g.data.heroAlt}
              meta={`${readingMinutes(g.body ?? "")} min read`}
            />
          ))}
        </div>
      </section>
    ))}

    <div class="max-w-3xl mx-auto">
      <LeadForm
        title="Get a Golden Visa property shortlist"
        subtitle="Tell us your tier, region and family situation. We reply within one business day with options that clear the 120 m² and single-deed tests."
        context="Golden Visa hub"
      />
    </div>
  </section>
</BaseLayout>
