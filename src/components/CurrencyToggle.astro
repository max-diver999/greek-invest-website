---
interface Props {
  variant?: 'header' | 'drawer';
}
const { variant = 'header' } = Astro.props;
---
<button type="button" class={`site-fx-toggle site-fx-toggle--${variant}`} data-site-fx-toggle aria-pressed="false" title="Show US dollar equivalents alongside euro figures">
  <span aria-hidden="true">$</span>
  <span class="site-fx-toggle__label">Show USD</span>
</button>

<style>
  .site-fx-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 36px;
    padding: 0.35rem 0.7rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-surface);
    color: var(--color-muted);
    font-family: inherit;
    font-size: 0.82rem;
    font-weight: 500;
    cursor: pointer;
    white-space: nowrap;
  }
  .site-fx-toggle[aria-pressed='true'] {
    background: var(--color-teal-light);
    border-color: var(--color-teal);
    color: var(--color-teal-dark);
  }
  .site-fx-toggle--drawer {
    width: 100%;
    min-height: 44px;
    justify-content: center;
    margin-bottom: 0.75rem;
    font-size: 0.9rem;
  }
  .site-fx-toggle--header {
    background: transparent;
    border-color: var(--color-frame-line);
    color: var(--color-frame-muted);
  }
  .site-fx-toggle--header:hover { color: var(--color-marble); border-color: var(--color-marble-deep); }
  .site-fx-toggle--header[aria-pressed='true'] {
    background: color-mix(in srgb, var(--color-marble) 16%, transparent);
    border-color: var(--color-marble-deep);
    color: var(--color-marble);
  }
  @media (max-width: 1100px) { .site-fx-toggle--header { display: none; } }
</style>
