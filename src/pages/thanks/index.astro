---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../data/site';

const isLead = Astro.url.searchParams.get('lead') === '1';
---
<BaseLayout
  title="Thank You"
  description="Thank you for contacting Greek Invest."
  noindex={true}
>
  <section class="site-container py-20 max-w-xl text-center">
    <p class="text-4xl mb-4">✓</p>
    <h1 class="mb-4">{isLead ? 'Request received' : 'Thank you'}</h1>
    <p class="text-[var(--color-muted)] mb-8">
      {isLead
        ? 'We received your shortlist request. Expect a reply by email or WhatsApp within one business day.'
        : `Thanks for visiting ${SITE.name}.`}
    </p>
    <a href="/guides/" class="btn-primary px-6 py-3">Browse guides</a>
  </section>
  {/* The conversion used to be an is:inline script inside `{isLead && …}`. It ran
      at parse time, three seconds before GoogleAnalytics.astro defines either
      gtag or the tracker, so every conversion was dropped. `track` queues until
      one exists. The script is unconditional because Astro hoists bundled
      scripts out of conditionals anyway, so the `?lead=1` check belongs here. */}
  <script>
    import { track } from '../../lib/track';

    if (new URLSearchParams(window.location.search).get('lead') === '1') {
      track('generate_lead', { lead_type: 'shortlist_form', value: 1, currency: 'USD' });
    }
  </script>
</BaseLayout>
